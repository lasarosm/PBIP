table 'Key Measures'
	lineageTag: 50db57b4-d8f1-4979-bd87-ae494964cbdc

	/// Percentage growth compared to previous period
	measure '% Growth' = DIVIDE([Gross Sales]-[Gross Sales PY],[Gross Sales PY])
		formatString: #,##0.00 %
		displayFolder: Growth%
		lineageTag: b751cb7a-62d6-4f58-b1f8-c8fbb3d02a5d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross sales from previous year
	measure 'Gross Sales PY' = CALCULATE([Gross Sales],SAMEPERIODLASTYEAR('Date'[Date]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Previous
		lineageTag: 05e24777-866b-4a82-b9ca-668c9c9f0aef

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Month-over-month change in sales
	measure MoM =
			
			CALCULATE([Gross Sales], DATEADD('Date'[Date], -1, MONTH))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Trends
		lineageTag: 7d55b9f4-e791-438d-9742-9ec55c816471

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Month-over-month change indicator
	measure '△ MoM' = [Gross Sales]-[MoM]
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 7b9c9b86-d519-4eba-a4b3-ca01c6280cff

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Percentage month-over-month change
	measure '% MoM' =
			
			VAR __PREV_MONTH = CALCULATE([Gross Sales], DATEADD('Date'[Date], -1, MONTH))
			RETURN
				DIVIDE([Gross Sales] - __PREV_MONTH, __PREV_MONTH)
		formatString: #,##0.00 %
		displayFolder: Growth%
		lineageTag: 9f4bd41f-456c-4ad9-9980-f5198fb684b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Gross sales for European region
	measure 'Gross Sales Europe' =
			
			CALCULATE ( [Gross Sales],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "Europe" )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Current
		lineageTag: 1146e2ce-1181-45f2-a372-1dd5aee26182

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross sales for Pacific region
	measure 'Gross Sales Pacific' =
			
			CALCULATE ( [Gross Sales],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "Pacific" )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Current
		lineageTag: df7cd35f-6eda-4185-809d-0d2e9b4e34bf

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross sales for North American region
	measure 'Gross Sales North America' =
			
			CALCULATE ( [Gross Sales],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "North America" )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Current
		lineageTag: 321e4548-3491-4ad0-9757-47c5d94748c4

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross sales for North American region in previous year
	measure 'Gross Sales PY North America' =
			
			CALCULATE ( [Gross Sales North America], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Previous
		lineageTag: dfde5539-efd4-4582-a27a-b5cb7a11907b

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Units sold in European region for previous year
	measure 'Units Sold PY Europe' =
			
			CALCULATE ( [Units Sold Europe], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Units Sold\Previous
		lineageTag: b0cb86ae-fba4-45b6-8d62-9ff1f25669b1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Gross sales for European region in previous year
	measure 'Gross Sales PY Europe' =
			
			CALCULATE ( [Gross Sales Europe], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Gross Sales\Previous
		lineageTag: aa5d41a3-7985-466a-8f27-a0595846950a

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Cost of goods sold as percentage to average territory
	measure 'COGS % to Avg Territory' = ```
			
			VAR TotalCOGS = SUM(Sales[TotalProductCost])
			VAR AvgCOGSTerritory = 
			    CALCULATE(
			        AVERAGE(Sales[TotalProductCost]),
			        ALLEXCEPT(Sales, Sales[SalesTerritoryKey])
			    )
			RETURN 
			    DIVIDE(TotalCOGS, AvgCOGSTerritory, 0)
			```
		formatString: #,##0.00 %
		displayFolder: COGs\Averages
		lineageTag: 22f2ea21-2a59-480a-9fa9-b71e90a4c863

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cost of goods sold as percentage to average month
	measure 'COGS % to Avg Month' = ```
			
			VAR TotalCOGS = SUM(Sales[TotalProductCost])
			VAR MonthCount = DISTINCTCOUNT('Date'[YearMonth])
			VAR AvgCOGSPerMonth = DIVIDE(TotalCOGS, MonthCount, 0)
			RETURN 
			    DIVIDE(TotalCOGS, AvgCOGSPerMonth, 0)
			```
		formatString: #,##0.00 %
		displayFolder: COGs\Averages
		lineageTag: 0e5f502b-7129-4628-a6ef-2f86e8915d79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cost of goods sold as percentage to average customer
	measure 'COGS % to Avg Customer' = ```
			
			VAR TotalCOGS = SUM(Sales[TotalProductCost])
			VAR CustomerCount = DISTINCTCOUNT(Sales[CustomerKey])
			VAR AvgCOGSPerCustomer = DIVIDE(TotalCOGS, CustomerCount, 0)
			RETURN 
			    DIVIDE(TotalCOGS, AvgCOGSPerCustomer, 0)
			```
		formatString: #,##0.00 %
		displayFolder: COGs\Averages
		lineageTag: 5a9d0bad-69c5-4c2a-828e-dc84d7693e64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Freight costs as percentage of total sales
	measure 'Freight % of Sales' =
			
			DIVIDE([Freight], [Gross Sales], 0)
		formatString: #,##0.00 %
		displayFolder: OPEX
		lineageTag: 60f3d8db-637b-4b8e-81b6-2c6f00a7d62b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Tax amount as percentage of total sales
	measure 'Tax % of Sales' =
			
			DIVIDE([Tax], [Gross Sales], 0)
		formatString: #,##0.00 %
		displayFolder: OPEX
		lineageTag: 7fdb6b4b-33d3-4866-af12-0dc5db9e5650

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Units sold in European region
	measure 'Units Sold Europe' =
			
			CALCULATE ( [Units Sold],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "Europe" )
			)
		formatString: 0
		displayFolder: Units Sold\Current
		lineageTag: 5dd0038a-842a-4f02-bb17-2129db0e55c6

	/// Units sold in Pacific region for previous year
	measure 'Units Sold PY Pacific' =
			
			CALCULATE ( [Units Sold Pacific], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,##0.00
		displayFolder: Units Sold\Previous
		lineageTag: 23aadb72-7750-4948-bc53-11663c1a5dda

	/// Units sold in Pacific region
	measure 'Units Sold Pacific' =
			
			CALCULATE ( [Units Sold],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "Pacific" )
			)
		formatString: 0
		displayFolder: Units Sold\Current
		lineageTag: 35a45b74-a9d9-4faf-a86b-95728a01cc9e

	/// Units sold in North American region
	measure 'Units Sold North America' =
			
			CALCULATE ( [Units Sold],
			    FILTER ( SalesTerritory, SalesTerritory[SalesContinent] = "North America" )
			)
		formatString: 0
		displayFolder: Units Sold\Current
		lineageTag: dff91d78-bc96-4bfa-b1db-145447f78cd1

	/// Units sold in North American region for previous year
	measure 'Units Sold PY North America' =
			
			CALCULATE ( [Units Sold North America], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0
		displayFolder: Units Sold\Previous
		lineageTag: 5d9a3e7b-4e2b-41f9-916b-e4185fdf59fd

	/// Average freight cost per order
	measure 'Avg Freight per Order' =
			
			DIVIDE([Freight], DISTINCTCOUNT(Sales[SalesOrderNumber]), 0)
		formatString: #,##0.00
		displayFolder: OPEX
		lineageTag: 20cee320-ac54-4bd9-9d59-c87c591e8964

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Total cost including COGS, freight, and tax per order
	measure 'Total Cost per Order' = [COGs] + [Freight] + [Tax]
		formatString: #,##0.00
		displayFolder: OPEX
		lineageTag: 1961537f-46c9-4a66-b938-decc72c4fcc2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average freight cost per product
	measure 'Freight per Product' =
			
			DIVIDE([Freight], DISTINCTCOUNT(Sales[ProductKey]), 0)
		formatString: #,##0.00
		displayFolder: OPEX
		lineageTag: 2c8e91ef-f165-46de-9e8a-a705e6cfc012

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Net profit after deducting freight costs and tax
	measure 'Net Profit After Freight & Tax' = [Gross Sales] - [COGs] - [Freight] - [Tax]
		formatString: #,##0.00
		displayFolder: OPEX
		lineageTag: 8c0faf0e-da0e-40d6-ac84-16317eeccb84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Trend analysis of freight costs over time
	measure 'Freight Trend' = CALCULATE([Freight], DATESYTD('Date'[Date]))
		formatString: #,##0.00
		displayFolder: Trends
		lineageTag: b1f01a97-034f-4d3b-99e4-933487b0cd53

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Trend analysis of tax amounts over time
	measure 'Tax Trend' = CALCULATE([Tax], DATESYTD('Date'[Date]))
		formatString: #,##0.00
		displayFolder: Trends
		lineageTag: b0444852-f9cb-420e-a273-7ccbd5bbb33f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Units sold as percentage to average customer
	measure 'Units Sold % to Avg Customer' = ```
			
			VAR TotalUnits = [Units Sold]
			VAR CustomerCount = DISTINCTCOUNT(Sales[CustomerKey])
			VAR AvgUnitsPerCustomer = DIVIDE(TotalUnits, CustomerCount, 0)
			RETURN 
			    DIVIDE(TotalUnits, AvgUnitsPerCustomer, 0)
			```
		formatString: #,##0.00 %
