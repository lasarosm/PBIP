	/// Units sold as percentage to average territory
	measure 'Units Sold % to Avg Territory' = ```
			
			VAR TotalUnits = [Units Sold]
			VAR AvgUnitsTerritory = 
			    CALCULATE(
			        AVERAGE(Sales[OrderQuantity]),
			        ALLEXCEPT(Sales, Sales[SalesTerritoryKey])
			    )
			RETURN 
			    DIVIDE(TotalUnits, AvgUnitsTerritory, 0)
			```
		formatString: #,##0.00 %
		displayFolder: Units Sold\Averages
		lineageTag: 2bad1ef6-83b1-4414-a350-b8606993e399

