model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Lists

	annotation PBI_QueryGroupOrder = 1

annotation PBI_QueryOrder = ["Customer","Date","Sales","Product","Base Measures","Key Measures","SalesTerritory","Server","DB","RangeStart","RangeEnd","YearCol","Promotion","ProductInventory"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation __TEdtr = 1

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table Customer
ref table Date
ref table Sales
ref table Product
ref table 'Base Measures'
ref table 'Key Measures'
ref table SalesTerritory
ref table Promotion
ref table ProductInventory

ref cultureInfo en-US

