/// Fact table containing individual internet sales transactions. Each row represents one order line with amounts, quantities, costs, and date references.
table Sales
	isHidden
	lineageTag: ba262a2b-bfe6-423e-96be-f752558ebf5b

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 3
		incrementalGranularity: day
		incrementalPeriods: 7
		sourceExpression =
			let
			    // 1. Data Source (Dynamic parameters)
			    Source = Sql.Database(Server, Database),
			    FactInternetSales = Source{[Schema="dbo", Item="FactInternetSales"]}[Data],
			
			    // 2. Select only required columns early (CRITICAL for performance)
			    SelectedColumns = Table.SelectColumns(FactInternetSales, {
			        "ProductKey",
			        "CustomerKey",
			        "OrderDateKey",
			        "ShipDateKey",
			        "DueDateKey",
			        "OrderDate",
			        "ShipDate",
			        "DueDate",
			        "SalesAmount",
			        "OrderQuantity",
			        "TotalProductCost",
			        "DiscountAmount",
			        "TaxAmt",
			        "Freight"
			    }),
			
			    // INCREMENTAL REFRESH — filter on OrderDate using RangeStart/RangeEnd
			    // Applied before any transforms to preserve query folding to SQL source
			    FilteredByRange = Table.SelectRows(SelectedColumns, each
			        [OrderDate] >= RangeStart and [OrderDate] < RangeEnd
			    ),
			
			    // 3. Data Type Normalization (keep folding intact)
			    RoundedNumerics = Table.TransformColumns(FilteredByRange, {
			        {"SalesAmount", each Number.Round(_, 2), type number},
			        {"TotalProductCost", each Number.Round(_, 2), type number},
			        {"DiscountAmount", each Number.Round(_, 2), type number},
			        {"TaxAmt", each Number.Round(_, 2), type number},
			        {"Freight", each Number.Round(_, 2), type number}
			    }),
			
			    // 4. Split datetime into Date + Time (hour-level granularity)
			    AddOrderDate = Table.AddColumn(RoundedNumerics, "Order Date", each Date.From([OrderDate]), type date),
			    AddOrderHour = Table.AddColumn(AddOrderDate, "Order Hour", each Time.Hour(Time.From([OrderDate])), Int64.Type),
			
			    AddShipDate = Table.AddColumn(AddOrderHour, "Ship Date", each Date.From([ShipDate]), type date),
			    AddShipHour = Table.AddColumn(AddShipDate, "Ship Hour", each Time.Hour(Time.From([ShipDate])), Int64.Type),
			
			    AddDueDate = Table.AddColumn(AddShipHour, "Due Date", each Date.From([DueDate]), type date),
			    AddDueHour = Table.AddColumn(AddDueDate, "Due Hour", each Time.Hour(Time.From([DueDate])), Int64.Type),
			
			    // 5. Data Quality Flags
			    AddQualityFlag = Table.AddColumn(AddDueHour, "Data Quality Flag", each
			        if [SalesAmount] < 0 then "Negative Sales"
			        else if [OrderQuantity] = 0 then "Zero Quantity"
			        else if [ProductKey] = null or [CustomerKey] = null then "Missing Keys"
			        else "OK"
			    ),
			
			    // 6. Remove original datetime columns (cardinality reduction)
			    RemovedDateTime = Table.RemoveColumns(AddQualityFlag, {
			        "OrderDate", "ShipDate", "DueDate"
			    }),
			
			    // 7. Rename for model alignment (star schema friendly)
			    RenamedColumns = Table.RenameColumns(RemovedDateTime, {
			        {"ProductKey", "Product ID"},
			        {"CustomerKey", "Customer ID"},
			        {"OrderDateKey", "Order Date ID"},
			        {"ShipDateKey", "Ship Date ID"},
			        {"DueDateKey", "Due Date ID"},
			        {"SalesAmount", "Sales Amount"},
			        {"OrderQuantity", "Order Quantity"},
			        {"TotalProductCost", "Product Cost"},
			        {"DiscountAmount", "Discount Amount"},
			        {"TaxAmt", "Tax Amount"}
			    }),
			
			    // 8. Final Data Types (LAST STEP ONLY)
			    FinalTypes = Table.TransformColumnTypes(RenamedColumns, {
			        {"Product ID", Int64.Type},
			        {"Customer ID", Int64.Type},
			        {"Order Date ID", Int64.Type},
			        {"Ship Date ID", Int64.Type},
			        {"Due Date ID", Int64.Type},
			        {"Sales Amount", Currency.Type},
			        {"Product Cost", Currency.Type},
			        {"Discount Amount", Currency.Type},
			        {"Tax Amount", Currency.Type},
			        {"Freight", Currency.Type},
			        {"Order Quantity", Int64.Type},
			        {"Order Hour", Int64.Type},
			        {"Ship Hour", Int64.Type},
			        {"Due Hour", Int64.Type}
			    }),
			    #"Removed Columns" = Table.RemoveColumns(FinalTypes,{"Order Date ID", "Ship Date ID", "Due Date ID", "Ship Hour", "Due Hour"}),
			    #"Filtered Rows" = Table.SelectRows(#"Removed Columns", each true),
			    #"Removed Columns1" = Table.RemoveColumns(#"Filtered Rows",{"Data Quality Flag"})
			
			in
			    #"Removed Columns1"

