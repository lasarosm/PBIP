		changedProperty = IsHidden

		annotation Synonyms = delivery date|expected date|due delivery|promise date

		annotation UnderlyingDateTimeDataType = Date

	/// Order hour grouped into time-of-day periods for sales pattern analysis
	column 'Time of Day' = SWITCH(TRUE(), Sales[Order Hour] >= 6 && Sales[Order Hour] < 12, "Morning (6–12)", Sales[Order Hour] >= 12 && Sales[Order Hour] < 17, "Afternoon (12–17)", Sales[Order Hour] >= 17 && Sales[Order Hour] < 21, "Evening (17–21)", "Night (21–6)")
		dataType: string
		isHidden
		displayFolder: Groups & Bins
		lineageTag: 99974c55-d370-41c2-a7c3-c80ad1db5c75

		changedProperty = IsHidden

	/// Sales amount grouped into transaction size tiers for revenue distribution analysis
	column 'Sales Amount Tier' = SWITCH(TRUE(), Sales[Sales Amount] < 100, "Small (< 100)", Sales[Sales Amount] < 500, "Medium (100–500)", Sales[Sales Amount] < 2000, "Large (500–2K)", Sales[Sales Amount] < 5000, "X-Large (2K–5K)", "Enterprise (5K+)")
		dataType: string
		isHidden
		displayFolder: Groups & Bins
		lineageTag: 62acfbf5-f5f2-4456-ae70-7e635c7e6bfa

		changedProperty = IsHidden

